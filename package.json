{
  "name": "@local/dsh-usage-hud",
  "version": "1.0.0",
  "private": true,
  "description": "DSH 网页版的实时用量看板：API 余额、缓存命中率、上下文占用、Token 消耗与预估费用。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node test/host-harness.mjs && node test/render-harness.mjs",
    "test:host": "node test/host-harness.mjs",
    "test:render": "node test/render-harness.mjs",
    "verify:install": "node test/verify-install.mjs",
    "verify:browser": "node test/browser-verify.mjs"
  }
}
